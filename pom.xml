<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.drakescraft_labs</groupId>
    <artifactId>SensibleToolbox-drake</artifactId>
    <version>1.22-Drake-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>SensibleToolbox-drake</name>
    <description>SensibleToolbox port integrado en stack Drake. Soporta Paper/Purpur 1.21.11, 26.1.x y 26.2.x con un solo jar.</description>

    <properties>

        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <!--
          API contra la que se compila. El jar resultante es Java 21 (release 21) y corre en
          1.21.11 (Java 21) y en 26.1.x / 26.2.x (Java 25). Los perfiles mc-26.1 y mc-26.2
          recompilan y ejecutan los tests contra esas APIs (requieren JDK 25).
        -->
        <paper.version>1.21.11-R0.1-SNAPSHOT</paper.version>
        <!-- APIs contra las que PaperApiCompatibilityIT valida el jar empaquetado. -->
        <paper.compat.1_21.version>1.21.11-R0.1-SNAPSHOT</paper.compat.1_21.version>
        <paper.compat.26_1.version>26.1.2.build.74-stable</paper.compat.26_1.version>
        <paper.compat.26_2.version>26.2.build.129-stable</paper.compat.26_2.version>
        <mockbukkit.artifactId>mockbukkit-v1.21</mockbukkit.artifactId>
        <mockbukkit.version>4.116.3</mockbukkit.version>
        <stb.requiredJdk>[21,)</stb.requiredJdk>
        <maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
        <maven.enforcer.plugin.version>3.6.3</maven.enforcer.plugin.version>
        <maven.dependency.plugin.version>3.11.0</maven.dependency.plugin.version>
        <asm.version>9.10.1</asm.version>
        <slimefun.version>RC-37</slimefun.version>
        <slimefun.drake.version>11.0-Universal-26.x-SNAPSHOT</slimefun.drake.version>
        <dough.version>1.3.1-DRAKE-v11-SNAPSHOT</dough.version>
        <infinitylib.version>1.3.11-DRAKE-SNAPSHOT</infinitylib.version>
        <sefilib.version>0.3.1-DRAKE-SNAPSHOT</sefilib.version>
        <networks.version>11.0.0-drake.6</networks.version>
        <gastronomicon.version>1.21.11-Drake.1</gastronomicon.version>

        <!-- Security Patches (2026 Standards) -->
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <guava.version>33.7.1-jre</guava.version>
        <spring.version>6.2.18</spring.version>
        <commons-io.version>2.22.0</commons-io.version>
        <jackson.version>2.22.3</jackson.version>
        <jackson.annotations.version>2.22</jackson.annotations.version>
        <log4j2.version>2.26.1</log4j2.version>
        <json.version>20231013</json.version>
        <plexus-utils.version>4.1.0</plexus-utils.version>
        <maven-shade.plexus-utils.version>3.6.1</maven-shade.plexus-utils.version>
        <maven.shade.plugin.version>3.6.2</maven.shade.plugin.version>
        <maven.surefire.plugin.version>3.5.4</maven.surefire.plugin.version>
        <bstats.version>3.2.1</bstats.version>
        <stb.packagedJar>${project.build.directory}/${project.build.finalName}.jar</stb.packagedJar>
        <httpcore5.version>5.4.4</httpcore5.version>
        <httpclient5.version>5.6.4</httpclient5.version>
        <maven.deploy.skip>false</maven.deploy.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Paper API -->
            <dependency>
                <groupId>io.papermc.paper</groupId>
                <artifactId>paper-api</artifactId>
                <version>${paper.version}</version>
